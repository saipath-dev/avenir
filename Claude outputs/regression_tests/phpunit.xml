<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="bootstrap.php" backupGlobals="false" colors="false" columns="max"
         failOnRisky="false" failOnWarning="false" cacheDirectory="../../writable/cache/phpunit" displayDetailsOnTestsThatTriggerWarnings="true">
    <testsuites>
        <testsuite name="newgen-php"><directory>php</directory></testsuite>
    </testsuites>
    <php>
        <env name="XDEBUG_MODE" value="off"/>
    </php>
</phpunit>
