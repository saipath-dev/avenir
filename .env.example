#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = your_database_name
database.default.username = your_database_username
database.default.password = your_database_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SMS GATEWAY (Text Origins)
#--------------------------------------------------------------------

SMS_SENDER_ID = 'AVENIR HLDS'
SMS_EMAIL = 'info@avenirholidays.com'
SMS_PASSWORD = 'your_sms_password_here'

#--------------------------------------------------------------------
# WHATSAPP CLOUD API (Meta/Facebook)
#--------------------------------------------------------------------
# Get these credentials from: https://developers.facebook.com/apps
# 1. Create a Facebook Business App
# 2. Add WhatsApp product
# 3. Get Phone Number ID from API Setup page
# 4. Generate permanent Access Token from System Users

WHATSAPP_PHONE_NUMBER_ID = 'your_phone_number_id_here'
WHATSAPP_ACCESS_TOKEN = 'your_permanent_access_token_here'

#--------------------------------------------------------------------
# IMPORTANT SECURITY NOTES
#--------------------------------------------------------------------
# 1. Copy this file to .env and fill in your actual credentials
# 2. Never commit .env file to version control (add to .gitignore)
# 3. Keep your access tokens secure and rotate them periodically
# 4. Use permanent tokens in production (not temporary 24-hour tokens)
#--------------------------------------------------------------------
